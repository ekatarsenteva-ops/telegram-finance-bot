# Telegram Bot API — токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API — ключ с console.anthropic.com
ANTHROPIC_API_KEY=

# Строка подключения к PostgreSQL — вставьте ссылку из Neon (см. README, шаг 4).
# Для локальной БД через Docker вместо этого используйте:
# postgresql://finance_bot:finance_bot@localhost:5432/finance_bot
DATABASE_URL=

# telegram_id владельца — единственный авторизованный пользователь на старте
OWNER_TELEGRAM_ID=

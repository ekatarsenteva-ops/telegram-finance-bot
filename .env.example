# Telegram Bot API — токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API — ключ с console.anthropic.com (не используется, если задан GEMINI_API_KEY)
ANTHROPIC_API_KEY=

# Google Gemini API — ключ с aistudio.google.com/apikey (бесплатный тариф)
GEMINI_API_KEY=

# Строка подключения к PostgreSQL — вставьте ссылку из Neon (см. README, шаг 4).
# Для локальной БД через Docker вместо этого используйте:
# postgresql://finance_bot:finance_bot@localhost:5432/finance_bot
DATABASE_URL=

# telegram_id владельца — всегда имеет доступ
OWNER_TELEGRAM_ID=

# telegram_id остальных доверенных людей через запятую (необязательно)
# Узнать свой telegram_id можно у бота @userinfobot
ALLOWED_TELEGRAM_IDS=
